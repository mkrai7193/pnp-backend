# Copy to `.env` (gitignored) for local development.

PORT=4000

# Comma-separated list of origins allowed to call this API (the web app's dev + prod URLs).
CORS_ORIGINS=http://localhost:5173,https://pnpsports.in

# This API's own public base URL — used to build the verification links sent by email.
# In production this must be the backend's real public URL, not the web app's.
BACKEND_PUBLIC_URL=http://localhost:4000

# Where a person is sent after clicking a verification link, for a "back to site" button.
FRONTEND_URL=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=pnp
DB_PASSWORD=pnp
DB_DATABASE=pnp_sports

# Resend (same provider/API already used by apps/web/worker for the waitlist email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=PNP Sports <notifications@pnpsports.in>
